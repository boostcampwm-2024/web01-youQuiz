{
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": ".e2e-spec.ts$",
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/../../shared/$1",
      "^src/(.*)$": "<rootDir>/../src/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    }
  }
